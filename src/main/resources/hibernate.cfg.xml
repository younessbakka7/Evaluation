<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- H2 In-Memory with MySQL compatibility -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:evaluation_db;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <property name="hibernate.hbm2ddl.auto">create-drop</property>
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Exercice 1 Entites -->
        <mapping class="ma.projet.classes.Categorie"/>
        <mapping class="ma.projet.classes.Produit"/>
        <mapping class="ma.projet.classes.Commande"/>
        <mapping class="ma.projet.classes.LigneCommandeProduit"/>

        <!-- Exercice 2 Entites -->
        <mapping class="ma.projet.classes.Employe"/>
        <mapping class="ma.projet.classes.Projet"/>
        <mapping class="ma.projet.classes.Tache"/>
        <mapping class="ma.projet.classes.EmployeTache"/>

        <!-- Exercice 3 Entites -->
        <mapping class="ma.projet.beans.Personne"/>
        <mapping class="ma.projet.beans.Homme"/>
        <mapping class="ma.projet.beans.Femme"/>
        <mapping class="ma.projet.beans.Mariage"/>
    </session-factory>
</hibernate-configuration>
